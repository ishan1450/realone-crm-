# Database Configuration
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/real_estate_crm

# JWT Security
AUTH_SECRET_KEY=your_secure_random_jwt_secret_key_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Meta Lead Ads Integration
# Obtain from Meta for Developers (developers.facebook.com)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v22.0
META_REDIRECT_URI=http://localhost:5173/meta/callback
META_WEBHOOK_VERIFY_TOKEN=your_custom_secure_webhook_verify_token
META_ACCESS_TOKEN=your_page_or_system_user_access_token

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
